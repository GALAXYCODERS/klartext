{
  "name": "klartext-presentation-template",
  "private": true,
  "version": "0.1.0",
  "description": "Klartext presentation template – offline single-file HTML presentations with GSAP, presenter view and PDF export",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pdf": "vite build && node scripts/pdf.mjs",
    "pdf:dark": "vite build && node scripts/pdf.mjs --dark",
    "notizen": "vite build && node scripts/notizen.mjs",
    "qa": "vite build && node scripts/qa.mjs",
    "contrast": "node scripts/contrast.mjs"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "playwright": "1.56.1",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GALAXYCODERS/klartext.git",
    "directory": "template"
  }
}
